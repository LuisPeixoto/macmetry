{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macmetry",
  "version": "0.1.0",
  "identifier": "dev.macmetry.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "macmetry",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 22, "y": 26 },
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "A fast, beautiful performance monitor for macOS",
    "longDescription": "macmetry shows CPU, memory, disk, network, GPU, temperatures, fans, power, battery and processes for your Mac, in a native app with a menu bar item, a history and alerts.",
    "copyright": "MIT License, Luis Peixoto",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
